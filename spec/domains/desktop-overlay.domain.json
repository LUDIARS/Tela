{
  "name": "desktop-overlay",
  "description": "対象ウインドウを持たず、デスクトップに単独で浮かぶ半透明の面を出す。モニタの作業領域を基準にした置き場所、モニタごとのDPIへの追従、画面外からの主モニタへの復帰、つまみのドラッグによる移動と移動後の位置の通知、画面取り込みからの除外を所有する。WindowsとmacOS(pointで解く配置とbackingScaleFactorへの追従)の両方の面を含む。半透明の出し方と入力の受け方はhost-overlayの合成を使い、内容の意味と位置の保存は持ち込まない。",
  "presetRules": [],
  "templateRules": [],
  "membership": [
    {
      "pathPattern": "(^|/)(src/domain/desktop/|src/infrastructure/windows/(windows_desktop_overlay|desktop_monitors)\\.(cpp|hpp)$|include/tela/(windows_desktop_overlay|macos_desktop_overlay|desktop_overlay_options|desktop_placement|desktop_points)\\.hpp$|tests/desktop_(placement|points)_test\\.cpp$)"
    },
    {
      "pathPattern": "(^|/)src/infrastructure/macos/(macos_desktop_overlay|desktop_screens|desktop_panel)\\.(mm|hpp)$"
    },
    {
      "pathPattern": "(^|/)examples/(desktop/desktop_(probe_content|probe_options)\\.(cpp|hpp)|windows/desktop_overlay_probe\\.cpp|macos/desktop_overlay_probe\\.mm)$"
    }
  ],
  "specRefs": [
    "spec/feature/desktop-overlay.md",
    "spec/contracts.md",
    "spec/windows-composition.md",
    "spec/macos-composition.md",
    "spec/ux/product.md"
  ]
}
