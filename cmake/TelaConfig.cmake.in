@PACKAGE_INIT@
if((@TELA_BUILD_WINDOWS@ OR @TELA_BUILD_MACOS@ OR @TELA_BUILD_PICTOR@ OR @TELA_BUILD_GPU@) AND NOT TARGET TelaPictorDependency)
  find_library(TELA_PICTOR_LIBRARY NAMES pictor REQUIRED)
  add_library(TelaPictorDependency UNKNOWN IMPORTED)
  set_target_properties(TelaPictorDependency PROPERTIES IMPORTED_LOCATION "${TELA_PICTOR_LIBRARY}")
  find_library(TELA_PICTOR_CORE_LIBRARY NAMES pictor_core)
  if(TELA_PICTOR_CORE_LIBRARY)
    set_property(TARGET TelaPictorDependency APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${TELA_PICTOR_CORE_LIBRARY}")
  endif()
endif()
if(@TELA_BUILD_GPU@)
  include(CMakeFindDependencyMacro)
  find_dependency(Vulkan)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TelaTargets.cmake")
check_required_components(Tela)
